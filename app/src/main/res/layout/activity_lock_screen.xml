<?xml version="1.0" encoding="utf-8"?>
<!-- YOK-037: the Yoke lock screen, shown over the system keyguard -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lockscreen.LockScreenActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="96dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="64sp"
            tools:text="02:34" />

        <TextClock
            android:id="@+id/date"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            tools:text="Sunday, 18 October" />

        <TextView
            android:id="@+id/weather"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="14° Partly cloudy"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/musicBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/nowPlaying"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Song — Artist" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/prev"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lock_screen_yoke_prev"
                    android:paddingVertical="12dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="24dp"
                    android:text="◀◀" />

                <TextView
                    android:id="@+id/playPause"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lock_screen_yoke_play_pause"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="▶" />

                <TextView
                    android:id="@+id/next"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lock_screen_yoke_next"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="▶▶" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notifications"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="6dp"
            android:visibility="gone"
            tools:text="Signal · 2   Anna: hi"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/unlockHint"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:padding="12dp"
        android:text="@string/lock_screen_yoke_unlock_hint"
        android:textColor="?attr/primaryColorTrans50" />
</FrameLayout>
